{
  "name": "erd-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "24.12.0",
    "pnpm": "10.11.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "build": "tsc -p tsconfig.build.json && vite build && vite build --config vite.api.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project postgresql"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.49.0",
    "playwright-core": "1.57.0",
    "vite": "7.2.7",
    "vitest": "4.0.15",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "fastify": "5.6.2",
    "@erd/model": "workspace:*",
    "@erd/sql-contract": "workspace:*",
    "@erd/sql-service": "workspace:*",
    "@erd/dialect-postgresql": "workspace:*",
    "@erd/test-fixtures": "workspace:*"
  }
}
