WEB_PORT=5173
API_PORT=3001
# API_HOST=127.0.0.1

# Full Compose stack. Keep local-only values for disposable development databases.
# HERD_HTTP_PORT=8080
# HERD_DB_PORT=55432
# HERD_NODE_ENV=development
# HERD_DEV_LOGIN=1
# HERD_LOCAL_AUTH=0
# HERD_DB_PASSWORD=herd-local-only
# HERD_API_MEMORY_LIMIT=1536m
# HERD_MIGRATION_DATABASE_URL=

# Optional server persistence. The defaults below match the local-only Compose DB.
# DATABASE_URL=postgresql://herd:herd-local-only@127.0.0.1:55432/herd
# APP_ORIGIN=http://127.0.0.1:5173

# Optional local sign-in. Never enable this on a deployed service.
# NODE_ENV=development
# ERD_DEV_LOGIN=1

# Built-in username and password authentication.
# ERD_LOCAL_AUTH=1

# OIDC client with authorization code, PKCE S256, and client_secret_basic.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# SQL job defaults for one API process.
# SQL_JOB_TIMEOUT_MS=10000
# SQL_JOB_TTL_MS=600000
# SQL_JOB_USER_LIMIT=2
# SQL_JOB_WORKERS=2
# SQL_JOB_MAX_INPUT_BYTES=5242880
# SQL_JOB_MAX_ACTIVE=64
# SQL_WORKER_HEAP_MB=256

# Document JSON and catalog limits.
# ERD_MAX_DOCUMENT_BYTES=20971520
# ERD_MAX_TABLES=1000
# ERD_MAX_COLUMNS=20000
# ERD_MAX_RELATIONSHIPS=5000

# Server version checkpoints per ERD.
# ERD_CHECKPOINT_INTERVAL_MS=600000
# ERD_CHECKPOINT_KEEP=50

# Client PNG export limits in pixels. Set before starting or building the web app.
# VITE_ERD_PNG_MAX_SIDE=4096
# VITE_ERD_PNG_MAX_PIXELS=16000000
